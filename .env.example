# Copy to .env and fill in. Never commit .env (it is git-ignored).
# Everything works offline without any of these (see `jobradar demo`).

# --- Source channel reader (Telegram USER session via MTProto; get these at my.telegram.org)
JOBRADAR_SOURCE_CHANNEL=software_jobs_linkedin
JOBRADAR_TELEGRAM_API_ID=
JOBRADAR_TELEGRAM_API_HASH=
JOBRADAR_BACKFILL_MAX_MESSAGES=500
JOBRADAR_BACKFILL_DAYS=7

# --- Private bot (create with @BotFather). Leave the user ID empty on first run: the bot
#     replies with your ID in setup mode. The chat ID defaults to your user ID (private chat).
JOBRADAR_BOT_TOKEN=
JOBRADAR_BOT_ALLOWED_USER_ID=
JOBRADAR_BOT_ALLOWED_CHAT_ID=
JOBRADAR_NOTIFY_MAX_PER_MINUTE=15

# --- LLM: Groq free tier (console.groq.com → API Keys). Use "none" for rules-only, fully local.
JOBRADAR_LLM_BACKEND=groq
JOBRADAR_GROQ_API_KEY=
JOBRADAR_LLM_MODEL=openai/gpt-oss-120b
JOBRADAR_LLM_FALLBACK_MODEL=openai/gpt-oss-20b
JOBRADAR_LLM_DAILY_TOKEN_BUDGET=150000
JOBRADAR_LLM_MAX_CALLS_PER_CYCLE=20

# --- Local embeddings (no API key; ~130 MB model downloads on first use into data/models)
JOBRADAR_EMBED_BACKEND=fastembed
JOBRADAR_EMBED_MODEL=BAAI/bge-small-en-v1.5

# --- Job page fetching: OFF by default. Check the site's terms before enabling.
#     When off (or blocked), use "Paste description" in the bot.
JOBRADAR_FETCH_ENABLED=false
JOBRADAR_FETCH_MAX_PER_CYCLE=5

# --- Gmail sending (gmail.send scope only). Put the OAuth client JSON at
#     data/gmail_client_secret.json, then run `jobradar auth-gmail`.
JOBRADAR_GMAIL_SENDER=

# --- Data directory (DB, Telegram session, OAuth token, CV copies). Mode 700.
JOBRADAR_DATA_DIR=data
